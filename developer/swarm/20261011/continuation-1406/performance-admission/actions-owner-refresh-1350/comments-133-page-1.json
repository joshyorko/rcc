M8AAAABPZTbiw","user":{"login":"joshyorko","id":54248591,"node_id":"MDQ6VXNlcjU0MjQ4NTkx","avatar_url":"https://avatars.githubusercontent.com/u/54248591?v=4","gravatar_id":"","url":"https://api.github.com/users/joshyorko","html_url":"https://github.com/joshyorko","followers_url":"https://api.github.com/users/joshyorko/followers","following_url":"https://api.github.com/users/joshyorko/following{/other_user}","gists_url":"https://api.github.com/users/joshyorko/gists{/gist_id}","starred_url":"https://api.github.com/users/joshyorko/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joshyorko/subscriptions","organizations_url":"https://api.github.com/users/joshyorko/orgs","repos_url":"https://api.github.com/users/joshyorko/repos","events_url":"https://api.github.com/users/joshyorko/events{/privacy}","received_events_url":"https://api.github.com/users/joshyorko/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-18T12:25:50Z","updated_at":"2026-08-18T12:25:50Z","body":"Cross-project implementation contract: https://github.com/joshyorko/rcc/issues/118\n\n#118 now defines the concrete RCC/Holotree v1 path consumed here:\n\n- cryptographic Environment Artifact Manifest + Object Index layered over existing v12 catalogs/current Hololib bytes;\n- explicit separation between legacy SipHash cache keys and remote trust identities;\n- provider publication/acquisition with verified objects and atomic manifest commit;\n- worker-local materialization, lease, Execution Handle, and GC semantics;\n- per-build/per-artifact/per-materialization coordination rather than a fleet-wide Holotree lock;\n- source-only autoreload reuse and generation-safe environment-changing reload;\n- a first two-process vertical that does not require a new catalog format, zstd, packfiles, FUSE, OCI, a daemon, or Kubernetes.\n\nTreat #118 as the engine-side authority and this issue as the Runtime adapter/consumer contract.","author_association":"OWNER","pin":null,"reactions":{"url":"https://api.github.com/repos/joshyorko/actions/issues/comments/5328133003/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openai/subscriptions","organizations_url":"https://api.github.com/users/openai/orgs","repos_url":"https://api.github.com/users/openai/repos","events_url":"https://api.github.com/users/openai/events{/privacy}","received_events_url":"https://api.github.com/users/openai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"ChatGPT Codex Connector","description":"Bring ChatGPT and Codex to your GitHub repositories.","external_url":"https://www.chatgpt.com","html_url":"https://github.com/apps/chatgpt-codex-connector","created_at":"2025-02-14T01:37:05Z","updated_at":"2026-09-23T18:52:59Z","permissions":{"actions":"write","checks":"read","contents":"write","emails":"read","issues":"write","metadata":"read","pull_requests":"write","statuses":"read","workflows":"write"},"events":["check_run","check_suite","commit_comment","issues","issue_comment","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","repository","status","sub_issues"]},"minimized":null},{"url":"https://api.github.com/repos/joshyorko/actions/issues/comments/5335428231","html_url":"https://github.com/joshyorko/actions/issues/133#issuecomment-5335428231","issue_url":"https://api.github.com/repos/joshyorko/actions/issues/133","id":5335428231,"node_id":"IC_kwDOOI-QjM8AAAABPgQshw","user":{"login":"joshyorko","id":54248591,"node_id":"MDQ6VXNlcjU0MjQ4NTkx","avatar_url":"https://avatars.githubusercontent.com/u/54248591?v=4","gravatar_id":"","url":"https://api.github.com/users/joshyorko","html_url":"https://github.com/joshyorko","followers_url":"https://api.github.com/users/joshyorko/followers","following_url":"https://api.github.com/users/joshyorko/following{/other_user}","gists_url":"https://api.github.com/users/joshyorko/gists{/gist_id}","starred_url":"https://api.github.com/users/joshyorko/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/joshyorko/subscriptions","organizations_url":"https://api.github.com/users/joshyorko/orgs","repos_url":"https://api.github.com/users/joshyorko/repos","events_url":"https://api.github.com/users/joshyorko/events{/privacy}","received_events_url":"https://api.github.com/users/joshyorko/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-08-18T23:21:53Z","updated_at":"2026-08-18T23:21:53Z","body":"## Implementation split and RCC lineage — 2026-08-18\n\nThis issue remains the full Actions environment-substrate contract. The board now has a bounded first implementation and explicit RCC dependencies.\n\n### Immediate Actions child\n\n- #134 — replace current local Action Server path/activation caching with an RCC EnvironmentBackend lifecycle while preserving current v2 package authoring, autoreload, frozen binary operation, and the existing process pool.\n\n#134 is intentionally local/collapsed. It proves the Runtime can keep Environment Artifact/materialization/lease identity authoritative before #90 introduces independent workers.\n\n### RCC program split\n\n- `joshyorko/rcc#120` — release Environment Artifacts v1 / v18.19.0 handoff;\n- `joshyorko/rcc#121` — supported-platform and ABI compatibility matrix;\n- `joshyorko/rcc#122` — lease/crash/repair/GC semantics;\n- `joshyorko/rcc#123` — production provider hardening;\n- `joshyorko/rcc#124` — ZIP/bundle/offline/OCI carrier convergence;\n- `joshyorko/rcc#125` — evidence-driven materializer/storage selection;\n- `joshyorko/rcc#126` — provenance/SBOM/signatures/revocation/trust;\n- `joshyorko/rcc#127` — cold-build coordination and prewarm.\n\nOnly #120 and the stable local lifecycle surface are prerequisites for the first #134 vertical. Do not block local Actions integration on every RCC follow-up.\n\n### Historical correction\n\nLegacy RCC already enabled same-platform portability through shared mode, Hololib ZIP export/import, and `rccremote` delta pull. The new contract does not invent transfer; it makes the existing capability cryptographically identified, natively publishable, usable from independent private RCC homes, lifecycle-managed through Materialization/Lease/Execution Handle, and schedulable by durable Artifact identity.\n\n### Handoff invariant\n\nActions may retain Environment Specification/Artifact digests, compatibility policy, trust decision, and provider reference. It must not retain `PYTHON_EXE`, `CONDA_PREFIX`, `ROBOCORP_HOME`, Holotree paths, provider URL, or RCC PID as durable identity.\n\nThe old `env-info/<hash>.json` path must have one bounded migration/validation authority, not remain an equal second source of truth indefinitely.","author_association":"OWNER","pin":null,"reactions":{"url":"https://api.github.com/repos/joshyorko/actions/issues/comments/5335428231/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openai/subscriptions","organizations_url":"https://api.github.com/users/openai/orgs","repos_url":"https://api.github.com/users/openai/repos","events_url":"https://api.github.com/users/openai/events{/privacy}","received_events_url":"https://api.github.com/users/openai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"ChatGPT Codex Connector","description":"Bring ChatGPT and Codex to your GitHub repositories.","external_url":"https://www.chatgpt.com","html_url":"https://github.com/apps/chatgpt-codex-connector","created_at":"2025-02-14T01:37:05Z","updated_at":"2026-09-23T18:52:59Z","permissions":{"actions":"write","checks":"read","contents":"write","emails":"read","issues":"write","metadata":"read","pull_requests":"write","statuses":"read","workflows":"write"},"events":["check_run","check_suite","commit_comment","issues","issue_comment","pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","repository","status","sub_issues"]},"minimized":null}]