{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>joshyorko/renovate-config:org-inherited-config"
  ],

  // RCC releases are expensive and safety-critical. Higher-risk PR creation
  // requires dashboard approval; every merge requires review and CI.
  "automerge": false,
  "platformAutomerge": false,
  "dependencyDashboardApproval": true,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,

  "ignorePaths": [
    ".dagger/go.mod",
    ".dagger/go.sum",
    "blobs/**",
    "build/**",
    "tmp/**"
  ],

  // Workflow changes receive Rcc CI. Discover updates, but require approval;
  // discovery and PR creation never grant merge or publication authority.
  "github-actions": {
    "enabled": true
  },
  "pip_requirements": {
    "enabled": true
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the official Go toolchain pin across RCC source, CI, and Dagger.",
      "managerFilePatterns": [
        "/^go\\.mod$/",
        "/^\\.github/workflows/(?:rcc|publish-release|export-release-evidence)\\.ya?ml$/",
        "/^scripts/release_publication\\.py$/",
        "/^\\.dagger/main\\.go$/"
      ],
      "matchStrings": [
        "(?:^|\\n)go\\s+(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "go-version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?",
        "defaultGoVersion\\s*=\\s*[\"'](?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']",
        "EXPECTED_GO_VERSION\\s*=\\s*\"go(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    }
  ],

  "packageRules": [
    {
      "description": [
        "RCC must never inherit central PatchRaptor automerge rules."
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "replacement",
        "rollback"
      ],
      "automerge": false,
      "platformAutomerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": [
        "Routine library patch PRs may open automatically; review and CI still gate every merge."
      ],
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/spf13/cobra", "github.com/spf13/viper", "gopkg.in/yaml.v3"],
      "matchUpdateTypes": ["patch"],
      "dependencyDashboardApproval": false
    },
    {
      "description": [
        "Keep official Go runtime updates coordinated across go.mod, CI, Dagger, and release provenance."
      ],
      "groupName": "Go toolchain",
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "matchPackageNames": [
        "go"
      ]
    },
    {
      "description": [
        "gopkg.in/yaml.v2 cannot take v3 releases without changing the module import path."
      ],
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "gopkg.in/yaml.v2"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
